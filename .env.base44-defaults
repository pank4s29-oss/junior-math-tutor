# Base44 local dev placeholders.
# These let the stack boot before real credentials are provided.
# Real secrets are delivered via /run/base44/app.env (listed AFTER this file in
# compose env_file), so a dashboard upload always overrides these placeholders.

# Browser/public Supabase config (frontend crashes at module load without these).
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=placeholder-anon-key

# Server-side Supabase config (tutor features error until real values are set).
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SECRET_KEY=placeholder-service-key
SUPABASE_DB_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

# Google Gemini (AI tutor) — falls back to this placeholder until provided.
GEMINI_API_KEY=placeholder-gemini-key

# App-internal cookie/JWT secret (generated; override via dashboard if desired).
JWT_SECRET=base44-dev-cookie-secret-change-me
