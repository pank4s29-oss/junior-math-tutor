# 複製此檔案為專案根目錄的 .env.local，再自行填入值。
# .env.local 已在 .gitignore；請勿將任何實際金鑰、URL 或資料庫密碼提交到 Git。

# 瀏覽器公開設定：Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 伺服器端設定：僅能留在 .env.local 或 Vercel Environment Variables
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
GEMINI_API_KEY=
# 選填：教師教材 PDF 擷取改走獨立金鑰／專案，避免與學生即時解題共用每日配額。
# 未設定時教材擷取會自動退回使用 GEMINI_API_KEY。
GEMINI_MATERIAL_API_KEY=

# 練習題庫背景補題排程（/api/cron/refill-practice-bank）的驗證密鑰。
# 部署到 Vercel 時：在 Environment Variables 設定同樣的值，並在 vercel.json 的
# crons 設定會自動帶入 Authorization: Bearer <CRON_SECRET> 呼叫這支端點。
# 未設定時，該端點會直接回傳 503 並停用，不會意外被公開觸發。
# 建議用 `openssl rand -hex 32` 產生一組隨機值。
CRON_SECRET=

# 本機 API 連接埠；前端 Vite 會將 /api 代理至此連接埠
TUTOR_API_PORT=3001
