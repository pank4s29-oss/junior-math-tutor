# 複製此檔案為專案根目錄的 .env.local，再自行填入值。
# .env.local 已在 .gitignore；請勿將任何實際金鑰、URL 或資料庫密碼提交到 Git。

# 瀏覽器公開設定：Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 伺服器端設定：僅能留在 .env.local 或 Vercel Environment Variables
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
GEMINI_API_KEY=

# 本機 API 連接埠；前端 Vite 會將 /api 代理至此連接埠
TUTOR_API_PORT=3001
